# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
**/__pycache__/
*.py[cod]
backend/.tmp/
backend/.tmp-tests/
backend/.model-cache/
backend/gcs-model-cache-test*/
backend/pytest-cache-files-*/
backend/pytest-temp*/
backend/verify-temp/
backend/uploads/*
!backend/uploads/.gitkeep
backend/static/figures/*
!backend/static/figures/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/data/*
!backend/data/.gitkeep
!backend/data/projects/
backend/data/projects/*
!backend/data/projects/.gitkeep
.tmp/
.codex-pytest-temp-*/
pytest-cache-files-*/
test-temp/
verify-temp/
.vercel
